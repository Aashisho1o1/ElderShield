{
  "manifest_version": 3,
  "name": "ElderShield for Gmail",
  "version": "0.1.0",
  "description": "Checks each email you open in Gmail for scam warning signs, using the ElderShield app on this computer.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8777/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
